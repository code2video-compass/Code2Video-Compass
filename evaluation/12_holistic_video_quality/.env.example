# Copy to .env and paste your Gemini API key (https://aistudio.google.com/apikey).
# .env is gitignored; keep real keys out of committed files.
GEMINI_API_KEY=your-api-key-here
# Optional: override the API root (default https://generativelanguage.googleapis.com).
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
